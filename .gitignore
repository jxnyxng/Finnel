# OS files
.DS_Store
Thumbs.db

# Editor / IDE files
.idea/
.vscode/
*.iml
*.iws
*.swp
*.swo

# Local environment / secrets
.env
.env.*
!.env.example
backend/.env
backend/.env.*
!backend/.env.example
frontend/.env
frontend/.env.*
!frontend/.env.example

# Logs
*.log
logs/
spring.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

